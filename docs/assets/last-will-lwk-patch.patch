+/// Sign an arbitrary Simplicity sighash (as returned by `SimplicityProgram.get_sighash_all`)
+/// with the key derived from `signer` at `derivation_path`, using BIP-340 Schnorr signing.
+///
+/// Use this (rather than `SimplicityProgram.create_p2pk_signature`) whenever the signing key
+/// is not also the contract's Taproot internal key -- e.g. a covenant with an unspendable
+/// (NUMS) internal key and multiple possible signing keys for different spending paths.
+#[uniffi::export]
+pub fn simplicity_sign_schnorr(
+    signer: &crate::Signer,
+    derivation_path: &DerivationPath,
+    sighash: &[u8],
+) -> Result<Vec<u8>, LwkError> {
+    let keypair = derive_keypair(signer, derivation_path)?;
+    let message =
+        lwk_wollet::secp256k1::Message::from_digest_slice(sighash).map_err(|e| LwkError::Generic {
+            msg: format!("invalid sighash: {e}"),
+        })?;
+    let signature = keypair.sign_schnorr(message);
+    Ok(signature.serialize().to_vec())
+}
