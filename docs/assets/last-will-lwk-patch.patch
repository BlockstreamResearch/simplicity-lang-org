+/// Load program source and compile it to a Simplicity program, optionally including debug
+/// symbols and enabling unstable compiler features (e.g. nominative `enum`s).
+///
+/// # Errors
+/// Returns error if the program fails to compile.
+pub fn load_program_with_unstable(
+    source: &str,
+    arguments: Arguments,
+    include_debug_symbols: bool,
+    unstable_features: &UnstableFeatures,
+) -> Result<CompiledProgram, ProgramError> {
+    let compiled = CompiledProgram::new_with_unstable(
+        source,
+        unstable_features,
+        arguments,
+        include_debug_symbols,
+        Box::new(ElementsJetHinter::new()),
+    )
+    .map_err(ProgramError::Compilation)?;
 
     Ok(compiled)
